# Copy to .env and fill in. NEVER commit .env.
# API key: Meko portal > Settings > API Keys > Generate API key (starts with mko_tkn_)
MEKO_API_KEY=
# Meko Cloud MCP endpoint (same for every account/datapack)
MEKO_MCP_URL=https://mcp.mekodata.ai/mcp
# Datapack NAME to use; created via datapack_create if it does not exist
MEKO_DATAPACK=trusttrace-test

# ---- PostgreSQL (authoritative decision log, activity log, replay protection, audit chain) ----
# See docs/database.md for the one-time role/database setup. URL-encode special characters in the password.
DATABASE_URL=
# DATABASE_SSL=false
# DB_POOL_MAX=10

# ---- REST API ----
# API_HOST=127.0.0.1
# API_PORT=8787
# SESSION_TTL_MINUTES=480
# SESSION_IDLE_MINUTES=30
# COOKIE_SECURE=false
# ALLOWED_ORIGINS=http://localhost:5173
# Behind a reverse proxy (e.g. a PaaS edge): number of trusted proxies that APPENDED to X-Forwarded-For. 0 (default) ignores the header.
# Choose from OBSERVATION, never a guess: too small is safe (shared proxy address), too large lets clients forge their IP. See docs/deployment.md.
# TRUST_PROXY_HOPS=0
# LEGACY, unsafe behind proxies that append (trusts the client-controlled FIRST entry). Cannot be combined with TRUST_PROXY_HOPS.
# TRUST_PROXY=false
# Serve the built dashboard (cd web && npm ci && npm run build) from this same process, same origin as /api. Unset = API only.
# WEB_DIST_DIR=web/dist
